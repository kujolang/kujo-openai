from tests.registry import create_fixture_registry, policy, audit, visible
from src.projection import discover, invoke
registry := create_fixture_registry()
request := parse_json(read_stdin(1048576))
context := {"principal":{"type":"workload","id":"fixture","tenant_id":"local","claims":{}},"invocation_id":"catalog"}
if request["operation"] == "discover" { print(to_json(discover(registry,context,visible))) } else {
 context["invocation_id"] := request["invocation_id"]
 print(to_json(invoke(registry,request["name"],request["input"],context,{"policy":policy,"audit":audit},visible)))
}
